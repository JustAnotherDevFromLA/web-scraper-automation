# Environment Configuration Template
# Copy to .env and update with your actual values

# Application
APP_NAME=Web Scraper Automation
DEBUG=false
ENVIRONMENT=development

# Database
DATABASE_URL=sqlite:///./scraper.db
# For PostgreSQL: postgresql://user:password@localhost:5432/scraper_db
MONGODB_URL=mongodb://localhost:27017/scraper_db
REDIS_URL=redis://localhost:6379/0
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Scraper Configuration
SCRAPER_TIMEOUT=30
SCRAPER_RETRIES=3
SCRAPER_BACKOFF_FACTOR=0.5
SCRAPER_RATE_LIMIT_REQUESTS_PER_SEC=5.0
SCRAPER_USE_PROXY=false
SCRAPER_PROXY_URL=
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
SCRAPER_HEADLESS_BROWSER=true

# Workflow Configuration
WORKFLOW_SCHEDULE_INTERVAL=3600
WORKFLOW_MAX_CONCURRENT_JOBS=5
WORKFLOW_JOB_TIMEOUT=3600
WORKFLOW_ENABLE_CELERY=false
WORKFLOW_CELERY_BROKER_URL=redis://localhost:6379/0

# Monitoring & Logging
MONITORING_LOG_LEVEL=INFO
MONITORING_JSON_LOGS=true
MONITORING_SENTRY_DSN=
MONITORING_SENTRY_ENV=development

# API Keys & Credentials (if needed)
# API_KEY=
# WEBHOOK_SECRET=
